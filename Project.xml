<?xml version="1.0" encoding="utf-8"?>
<project>
        <app title="FNF: Vs Void" file="VsVoid" packageName="com.kadedev.kadeenginevoid" package="com.kadedev.kadeenginevoid" main="Main" version="0.2.7.1" company="kadedev" />

        <set name="APP_ID" value="0x0100f6c013bbc000" />
        <app preloader="flixel.system.FlxPreloader" />
        <set name="SWF_VERSION" value="11.8" />

        <window width="1280" height="720" fps="60" background="#000000" hardware="true" vsync="false" />

        <window if="mobile" orientation="landscape" fullscreen="true" width="0" height="0" resizable="false"/>
        <window if="desktop" orientation="landscape" fullscreen="false" resizable="true" vsync="false"/>

        <set name="BUILD_DIR" value="export/debug" if="debug" />
        <set name="BUILD_DIR" value="export/release" unless="debug" />

        <classpath name="source" />

        <assets path="assets/preload" rename="assets" exclude="*.mp3" if="android" />
        <assets path="assets/preload" rename="assets" exclude="*.ogg" if="web" />

        <define name="PRELOAD_ALL" unless="web" />
        <define name="NO_PRELOAD_ALL" unless="PRELOAD_ALL"/>

        <section if="PRELOAD_ALL">
                <library name="songs"    preload="true" />
                <library name="shared"   preload="true" />
                <library name="tutorial" preload="true" />
                <library name="week1"    preload="true" />
                <library name="week2"    preload="true" />
                <library name="week3"    preload="true" />
                <library name="week4"    preload="true" />
                <library name="week5"    preload="true" />
                <library name="week6"    preload="true" />
        </section>

        <assets path="assets/songs"    library="songs"    exclude="*.mp3" if="android" />
        <assets path="assets/shared"   library="shared"   exclude="*.mp3" if="android" />
        <assets path="assets/tutorial" library="tutorial" exclude="*.mp3" if="android" />
        <assets path="assets/week1"    library="week1"    exclude="*.mp3" if="android" />
        <assets path="assets/week2"    library="week2"    exclude="*.mp3" if="android" />
        <assets path="assets/week3"    library="week3"    exclude="*.mp3" if="android" />
        <assets path="assets/week4"    library="week4"    exclude="*.mp3" if="android" />
        <assets path="assets/week5"    library="week5"    exclude="*.mp3" if="android" />
        <assets path="assets/week6"    library="week6"    exclude="*.mp3" if="android" />
        <assets path="assets/fonts"    embed='true'/>

        <assets path='example_mods' rename='mods' embed='false'/>
        <assets path='art/readme.txt' rename='do NOT readme.txt' />
        <assets path='LICENSE' rename='LICENSE.txt' />

        <haxelib name="flixel" />
        <haxelib name="flixel-addons" />
        <haxelib name="hscript" />
        <haxelib name="actuate" />
        <haxelib name="flixel-ui" />
        <haxelib name="polymod"/>

        <haxelib name="extension-androidtools" if="android" />

        <haxelib name="discord_rpc" if="windows"/>
        <haxelib name="linc_luajit" if="windows"/>

        <haxedef name="FLX_NO_MOUSE" if="mobile" />
        <haxedef name="FLX_NO_KEYBOARD" if="mobile" />
        <haxedef name="FLX_NO_TOUCH" if="desktop" />
        <haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />
        <haxedef name="HXCPP_GC_BIG_BLOCKS"/>

        <config android="gradle" />
        <config android="minSdkVersion" value="21" />
        <config android="targetSdkVersion" value="33" />

        <config android="permission" name="android.permission.INTERNET" />
        <config android="permission" name="android.permission.ACCESS_NETWORK_STATE" />
        <config android="permission" name="android.permission.VIBRATE" />
        <config android="permission" name="android.permission.RECORD_AUDIO" />
        <config android="permission" name="android.permission.MODIFY_AUDIO_SETTINGS" />

        <icon path="art/icon16.png" size='16'/>
        <icon path="art/icon32.png" size='32'/>
        <icon path="art/icon64.png" size='64'/>
        <icon path="art/icon128.png" size='128'/>
        <icon path="art/icon256.png" size='256'/>
        <icon path="art/icon512.png" size='512'/>
        <icon path="art/iconNEW.png" />

</project>